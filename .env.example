# ==========================================
# PagePulse - Environment Configuration Example
# Copy to .env for local development
# ==========================================

# Runtime mode: development, production, test
NODE_ENV=development

# Canonical public application origin
APP_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pagepulse

# Redis connection string for BullMQ and concurrency controls
REDIS_URL=redis://localhost:6379

# Better Auth signing/encryption secret (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=changeme_minimum_32_character_hex_secret_here

# Base URL used by Better Auth
BETTER_AUTH_URL=http://localhost:3000

# Artifact storage driver: 'local' (development/testing) or 's3' (production/R2/AWS)
ARTIFACT_STORAGE_DRIVER=local
ARTIFACT_LOCAL_DIR=./storage/artifacts

# S3-compatible object storage (required if ARTIFACT_STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pagepulse-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Encryption key for sensitive notification endpoint configs at rest (32-byte hex key)
ARTIFACT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email delivery (Resend). Leave blank in local development for console delivery adapter.
RESEND_API_KEY=
EMAIL_FROM=alerts@pagepulse.dev

# Telegram Bot integration (optional shared bot token)
TELEGRAM_BOT_TOKEN=

# Browser capture settings
CAPTURE_TIMEOUT_MS=30000
GLOBAL_WORKER_CONCURRENCY=4
PER_HOST_CONCURRENCY=1

# Snapshot and check-run retention in days
DEFAULT_SNAPSHOT_RETENTION_DAYS=90

# Optional error monitoring
SENTRY_DSN=
