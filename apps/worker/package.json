{
  "name": "@pagepulse/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "worker": "node ./dist/index.js --worker",
    "scheduler": "node ./dist/index.js --scheduler",
    "start": "node ./dist/index.js --all"
  },
  "dependencies": {
    "@pagepulse/browser": "workspace:*",
    "@pagepulse/config": "workspace:*",
    "@pagepulse/core": "workspace:*",
    "@pagepulse/db": "workspace:*",
    "@pagepulse/notifications": "workspace:*",
    "bullmq": "^6.3.14",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2"
  }
}
